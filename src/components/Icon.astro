---
// Carbon icons (from @carbon/icons, 32px artboard), drawn inline so they inherit text colour.
interface Props { name: 'arrow-right' | 'arrow-down' | 'launch' | 'menu' | 'close' | 'play'; size?: 16 | 20 | 24 | 32; class?: string }
const { name, size = 20, class: cls } = Astro.props;
const paths: Record<Props['name'], string[]> = {
  'arrow-right': ['M18 6l-1.43 1.393L24.15 15H4v2h20.15l-7.58 7.573L18 26l10-10L18 6z'],
  'arrow-down': ['M24.59 16.59L17 24.17V4h-2v20.17l-7.59-7.58L6 18l10 10 10-10-1.41-1.41z'],
  launch: [
    'M26 28H6a2.002 2.002 0 01-2-2V6a2.002 2.002 0 012-2h10v2H6v20h20V16h2v10a2.002 2.002 0 01-2 2z',
    'M20 2v2h6.586L18 12.586 19.414 14 28 5.414V12h2V2H20z',
  ],
  menu: ['M4 6h24v2H4zM4 24h24v2H4zM4 12h24v2H4zM4 18h24v2H4z'],
  close: ['M24 9.4L22.6 8 16 14.6 9.4 8 8 9.4 14.6 16 8 22.6 9.4 24 16 17.4 22.6 24 24 22.6 17.4 16 24 9.4z'],
  play: ['M7 28a1 1 0 01-1-1V5a1 1 0 011.48-.88l20 11a1 1 0 010 1.76l-20 11A1 1 0 017 28z'],
};
---
<svg class={cls} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  {paths[name].map((d) => <path fill="currentColor" d={d} />)}
</svg>
